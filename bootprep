#!/usr/bin/env bash
#
# bootprep
#
# Boot preparation engine for Debian, Ubuntu, and their derivatives using
# Snapper with the default nested Btrfs subvolume layout.
#
# Version: 1.0.1
# License: GPL-3.0-or-later
