#!/usr/bin/env bash
#
# bootprep
#
# Boot preparation engine for GRUB-based Linux systems using Snapper with a
# nested Btrfs snapshot layout.
#
# Version: 2.0.0
# License: GPL-3.0-or-later
#
# Copyright (C) 2026 Scott McClain
