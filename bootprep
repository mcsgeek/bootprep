set -euo pipefail

###############################################################################
# Global State
###############################################################################

PROGRAM="bootprep"
VERSION="2.0.0"

DEBUG="${DEBUG:-false}"

COMMAND="${1:-}"
SNAPSHOT_NUM="${2:-}"

ROOT_DEVICE=""
ROOT_UUID=""
SNAPSHOT_SUBVOL=""
SNAPSHOT_SUBVOL_ID=""
SNAPSHOT_PATH=""
WORKDIR=""
MOUNTPOINT=""
ROOT_SUBVOL=""
BASE_SUBVOL=""
HOME_SUBVOL=""
EFI_VENDOR=""
BOOTPREP_BACKUP_DIR="/var/lib/bootprep/backups"
EFI_TARGET=""

###############################################################################
# Output
###############################################################################

log() { printf '[INFO]  %s\n' "$*"; }

dbg() {

    if [[ "$DEBUG" == "true" ]]; then
        printf '[DEBUG] %s\n' "$*"
    fi

    return 0

}

die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

transaction_ok() {
    printf '[ OK ] %s\n' "$1"
    return 0
}

transaction_fail() {
    die "$1"
}

###############################################################################
# Validation
###############################################################################

validate() {

    [[ $EUID -eq 0 ]] \
        || die "Must be run as root."

    case "$COMMAND" in
        prepare)
            ;;
        *)
            die "Usage: $0 prepare <snapshot-number>"
            ;;
    esac

    [[ "$SNAPSHOT_NUM" =~ ^[0-9]+$ ]] \
        || die "Usage: $0 prepare <snapshot-number>"

    [[ "$(findmnt -n -o FSTYPE /)" == "btrfs" ]] \
        || die "The root filesystem is not Btrfs."

    [[ -d /sys/firmware/efi ]] \
        || die "The system is not booted in UEFI mode."

    mountpoint -q /boot/efi \
        || die "/boot/efi is not mounted."

    local command
    for command in awk btrfs chroot findmnt mount mountpoint paste sed umount; do
        command -v "$command" >/dev/null 2>&1 \
            || die "Required command not found: $command"
    done

    return 0
}

###############################################################################
# Snapshot Discovery
###############################################################################

discover_snapshot() {

    ROOT_DEVICE="$(findmnt -n -o SOURCE /)"
    ROOT_DEVICE="${ROOT_DEVICE%%[*}"

    ROOT_UUID="$(findmnt -n -o UUID /)"

    [[ -n "$ROOT_UUID" ]] \
        || transaction_fail "Unable to determine the root Btrfs filesystem UUID."

    ROOT_SUBVOL="$(
        findmnt -n -o OPTIONS / |
        sed -n 's/.*subvol=\/\([^,]*\).*/\1/p'
    )"

    [[ -n "$ROOT_SUBVOL" ]] \
        || transaction_fail "Unable to determine the active root subvolume."

    BASE_SUBVOL="$ROOT_SUBVOL"

    if [[ "$BASE_SUBVOL" == */.snapshots/*/snapshot ]]; then
        BASE_SUBVOL="${BASE_SUBVOL%%/.snapshots/*}"
    fi

    [[ -n "$BASE_SUBVOL" ]] \
        || transaction_fail "Unable to determine the base root subvolume."

    SNAPSHOT_SUBVOL="${BASE_SUBVOL}/.snapshots/${SNAPSHOT_NUM}/snapshot"
    SNAPSHOT_PATH="/.snapshots/${SNAPSHOT_NUM}/snapshot"

    [[ -d "$SNAPSHOT_PATH" ]] \
        || transaction_fail "Snapshot directory not found: $SNAPSHOT_PATH"

    btrfs subvolume show "$SNAPSHOT_PATH" >/dev/null 2>&1 \
        || transaction_fail "Snapshot path is not a Btrfs subvolume: $SNAPSHOT_PATH"

    SNAPSHOT_SUBVOL_ID="$(btrfs inspect-internal rootid "$SNAPSHOT_PATH")"

    [[ "$SNAPSHOT_SUBVOL_ID" =~ ^[0-9]+$ ]] \
        || transaction_fail "Unable to determine the snapshot subvolume ID."

    dbg "Root device     : $ROOT_DEVICE"
    dbg "Root UUID       : $ROOT_UUID"
    dbg "Root subvolume  : $ROOT_SUBVOL"
    dbg "Base subvolume  : $BASE_SUBVOL"
    dbg "Snapshot subvol : $SNAPSHOT_SUBVOL"
    dbg "Snapshot ID     : $SNAPSHOT_SUBVOL_ID"

    transaction_ok "Snapshot located"
    return 0
}

###############################################################################
# Snapshot Mounting
###############################################################################

mount_snapshot() {

    WORKDIR="$(mktemp -d /run/${PROGRAM}.XXXXXX)"
    MOUNTPOINT="$WORKDIR/snapshot"

    mkdir -p "$MOUNTPOINT"

    log "Mounting rollback snapshot..."

    mount -t btrfs -o "subvolid=$SNAPSHOT_SUBVOL_ID" "$ROOT_DEVICE" "$MOUNTPOINT"

    mountpoint -q "$MOUNTPOINT" \
        || transaction_fail "Snapshot mount failed."

    findmnt "$MOUNTPOINT" >/dev/null \
        || transaction_fail "Mounted snapshot could not be verified."

    [[ "$(btrfs property get -ts "$MOUNTPOINT" ro)" == "ro=false" ]] \
        || transaction_fail "Selected snapshot is read-only. Make it writable before preparing it."

    transaction_ok "Snapshot mounted"
    return 0
}

bind_runtime_filesystems() {

    mkdir -p "$MOUNTPOINT"/{dev,proc,sys,run}

    for d in dev sys; do
        mount --rbind "/$d" "$MOUNTPOINT/$d"
        mount --make-rslave "$MOUNTPOINT/$d"
        mountpoint -q "$MOUNTPOINT/$d" || transaction_fail "Failed to bind $d"
    done

    for d in proc run; do
        mount --bind "/$d" "$MOUNTPOINT/$d"
        mountpoint -q "$MOUNTPOINT/$d" || transaction_fail "Failed to bind $d"
    done

    if mountpoint -q /boot; then
        mkdir -p "$MOUNTPOINT/boot"
        mount --bind /boot "$MOUNTPOINT/boot"
    fi

    mountpoint -q /boot/efi \
        || transaction_fail "/boot/efi is not mounted."

    mkdir -p "$MOUNTPOINT/boot/efi"
    mount --bind /boot/efi "$MOUNTPOINT/boot/efi"

    [[ -x "$MOUNTPOINT/usr/bin/grub-mkconfig" || -x "$MOUNTPOINT/usr/sbin/grub-mkconfig" ]] \
        || transaction_fail "grub-mkconfig is not installed in the selected snapshot."

    [[ -x "$MOUNTPOINT/usr/bin/grub-install" || -x "$MOUNTPOINT/usr/sbin/grub-install" ]] \
        || transaction_fail "grub-install is not installed in the selected snapshot."

    transaction_ok "Bind mounts"
    return 0
}

###############################################################################
# Snapshot Store Mount Reconciliation
###############################################################################

discover_home_subvolume() {

    local home_target
    local home_options

    home_target="$(findmnt -n -o TARGET -T /home 2>/dev/null || true)"
    HOME_SUBVOL=""

    if [[ "$home_target" == "/home" ]]; then
        home_options="$(findmnt -n -o OPTIONS /home 2>/dev/null || true)"

        HOME_SUBVOL="$(
            sed -n 's/.*subvol=\/\([^,]*\).*/\1/p' <<< "$home_options"
        )"
    fi

    dbg "Home subvolume  : ${HOME_SUBVOL:-not separate}"
    return 0
}

discover_snapshot_stores() {

    local path
    local root_store="${BASE_SUBVOL}/.snapshots"
    local home_store

    discover_home_subvolume

    if [[ -n "$HOME_SUBVOL" ]]; then
        home_store="${HOME_SUBVOL}/.snapshots"
    else
        home_store="${BASE_SUBVOL}/home/.snapshots"
    fi

    while IFS= read -r path; do
        case "${path}" in
            ".snapshots"|"${root_store}")
                printf '%s\t%s\n' "${root_store}" "/.snapshots"
                ;;
            "${home_store}")
                printf '%s\t%s\n' "${path}" "/home/.snapshots"
                ;;
        esac
    done < <(
        btrfs subvolume list / |
        awk '
            {
                sub(/^.* path /, "")
                if ($0 ~ /(^|\/)\.snapshots$/)
                    print
            }
        '
    )

    return 0
}

snapshot_mount_options() {

    local options

    options="$(
        findmnt -n -o OPTIONS / |
        tr ',' '\n' |
        awk '
            $0 == "rw" || $0 == "ro" { next }
            $0 ~ /^subvol=/ { next }
            $0 ~ /^subvolid=/ { next }
            $0 ~ /^space_cache=/ { next }
            NF { print }
        ' |
        paste -sd, -
    )"

    if [[ -n "$options" ]]; then
        options="defaults,$options"
    else
        options="defaults"
    fi

    printf '%s\n' "$options"
}

fstab_entry_is_correct() {

    local line="$1"
    local expected_subvol="$2"
    local source
    local _target
    local fstype
    local options

    read -r source _target fstype options _ <<< "$line"

    [[ "$fstype" == "btrfs" ]] || return 1
    [[ ",$options," == *",subvol=/$expected_subvol,"* ]] || return 1

    case "$source" in
        "UUID=${ROOT_UUID}"|"${ROOT_DEVICE}")
            ;;
        *)
            return 1
            ;;
    esac

    return 0
}

canonical_fstab_entry() {

    local subvol="$1"
    local mountpoint="$2"
    local options="$3"

    printf 'UUID=%s %s btrfs subvol=/%s,%s 0 0\n' \
        "$ROOT_UUID" \
        "$mountpoint" \
        "$subvol" \
        "$options"
}

reconcile_fstab_entry() {

    local fstab="$1"
    local subvol="$2"
    local mountpoint="$3"
    local options="$4"
    local canonical="$5"
    local tmpfile="$6"

    local line
    local -a matches=()

    mapfile -t matches < <(
        awk -v target="$mountpoint" '
            /^[[:space:]]*#/ || NF == 0 { next }
            $2 == target { print }
        ' "$fstab"
    )

    case "${#matches[@]}" in
        0)
            printf '%s\n' "$canonical" >> "$tmpfile"
            log "Adding snapshot store mount: $mountpoint"
            ;;
        1)
            line="${matches[0]}"

            if fstab_entry_is_correct "$line" "$subvol"; then
                return 0
            fi

            awk -v target="$mountpoint" -v replacement="$canonical" '
                BEGIN {
                    replaced = 0
                }

                /^[[:space:]]*#/ || NF == 0 {
                    print
                    next
                }

                $2 == target {
                    if (replaced == 0) {
                        print replacement
                        replaced = 1
                    }
                    next
                }

                {
                    print
                }

                END {
                    if (replaced != 1)
                        exit 1
                }
            ' "$tmpfile" > "${tmpfile}.new" \
                || transaction_fail "Unable to replace the fstab entry for $mountpoint."

            mv "${tmpfile}.new" "$tmpfile"
            log "Replacing snapshot store mount: $mountpoint"
            ;;
        *)
            transaction_fail "Multiple active fstab entries found for $mountpoint."
            ;;
    esac

    return 0
}

verify_reconciled_fstab() {

    local fstab="$1"
    shift

    local subvol
    local mountpoint
    local line
    local -a matches=()

    while (( $# >= 2 )); do
        subvol="$1"
        mountpoint="$2"
        shift 2

        mapfile -t matches < <(
            awk -v target="$mountpoint" '
                /^[[:space:]]*#/ || NF == 0 { next }
                $2 == target { print }
            ' "$fstab"
        )

        [[ "${#matches[@]}" -eq 1 ]] \
            || transaction_fail "Snapshot store mount validation failed for $mountpoint."

        line="${matches[0]}"

        fstab_entry_is_correct "$line" "$subvol" \
            || transaction_fail "Snapshot store mount validation failed for $mountpoint."
    done

    return 0
}

reconcile_snapshot_store_mounts() {

    local target_root="$1"
    local fstab="${target_root}/etc/fstab"
    local options
    local tmpfile
    local backup_file
    local changed=false
    local subvol
    local mountpoint
    local canonical
    local -a stores=()
    local -a verify_args=()

    [[ -f "$fstab" ]] \
        || transaction_fail "Snapshot fstab not found."

    mapfile -t stores < <(discover_snapshot_stores)

    if [[ "${#stores[@]}" -eq 0 ]]; then
        transaction_ok "No snapshot store mounts required"
        return 0
    fi

    options="$(snapshot_mount_options)"
    tmpfile="$(mktemp "${WORKDIR}/fstab.XXXXXX")"
    cp -a "$fstab" "$tmpfile"

    for store in "${stores[@]}"; do
        IFS=$'\t' read -r subvol mountpoint <<< "$store"

        canonical="$(canonical_fstab_entry "$subvol" "$mountpoint" "$options")"
        verify_args+=("$subvol" "$mountpoint")

        if ! awk -v target="$mountpoint" '
            /^[[:space:]]*#/ || NF == 0 { next }
            $2 == target { found = 1 }
            END { exit(found ? 0 : 1) }
        ' "$fstab"; then
            changed=true
        else
            local existing_line
            existing_line="$(
                awk -v target="$mountpoint" '
                    /^[[:space:]]*#/ || NF == 0 { next }
                    $2 == target { print; exit }
                ' "$fstab"
            )"

            if ! fstab_entry_is_correct "$existing_line" "$subvol"; then
                changed=true
            fi
        fi

        reconcile_fstab_entry \
            "$fstab" \
            "$subvol" \
            "$mountpoint" \
            "$options" \
            "$canonical" \
            "$tmpfile"
    done

    verify_reconciled_fstab "$tmpfile" "${verify_args[@]}"

    if [[ "$changed" == "false" ]]; then
        rm -f "$tmpfile"
        transaction_ok "Snapshot store mounts verified"
        return 0
    fi

    mkdir -p "${target_root}${BOOTPREP_BACKUP_DIR}"
    backup_file="${target_root}${BOOTPREP_BACKUP_DIR}/fstab.$(date +%Y%m%d-%H%M%S)"

    cp -a "$fstab" "$backup_file"
    cp -a "$tmpfile" "$fstab"

    verify_reconciled_fstab "$fstab" "${verify_args[@]}" \
        || {
            cp -a "$backup_file" "$fstab"
            transaction_fail "Snapshot fstab update failed and was restored."
        }

    rm -f "$tmpfile"

    log "fstab backup    : ${backup_file#"$target_root"}"
    transaction_ok "Snapshot store mounts reconciled"
    return 0
}

###############################################################################
# GRUB Preparation
###############################################################################

prepare_grub() {

    log "Verifying snapshot root..."
    chroot "$MOUNTPOINT" findmnt /

    log "Generating GRUB configuration from the selected snapshot..."

    chroot "$MOUNTPOINT" /usr/bin/env -i \
        HOME=/root \
        PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        LANG="${LANG:-C}" \
        TERM="${TERM:-linux}" \
        TMPDIR=/tmp \
        TMP=/tmp \
        TEMP=/tmp \
        TEMPDIR=/tmp \
        grub-mkconfig -o /boot/grub/grub.cfg

    [[ -s "${MOUNTPOINT}/boot/grub/grub.cfg" ]] \
        || transaction_fail "Snapshot grub.cfg was not generated."

    transaction_ok "GRUB regenerated"

    return 0
}

###############################################################################
# EFI Bootloader Discovery
###############################################################################

discover_efi() {

    local candidate
    local directory
    local loader
    local machine
    local loader_found
    local -a candidates=()
    local -a loader_directories=()

    log "Discovering EFI bootloader target..."

    mountpoint -q /boot/efi \
        || transaction_fail "/boot/efi is not mounted."

    [[ -r "$MOUNTPOINT/etc/os-release" ]] \
        || transaction_fail "Selected snapshot has no /etc/os-release."

    # shellcheck disable=SC1091
    source "$MOUNTPOINT/etc/os-release"

    dbg "OS ID          : ${ID:-unknown}"
    dbg "OS ID_LIKE     : ${ID_LIKE:-}"

    candidates+=("${ID:-}")
    for candidate in ${ID_LIKE:-}; do candidates+=("$candidate"); done

    for directory in /boot/efi/EFI/*; do
        [[ -d "$directory" ]] || continue
        candidate="${directory##*/}"
        [[ "$candidate" =~ ^[A-Za-z0-9._-]+$ ]] || continue
        loader_found=false
        for loader in "$directory"/*; do
            [[ -f "$loader" ]] || continue
            case "${loader##*/}" in
                *[Gg][Rr][Uu][Bb]*.[Ee][Ff][Ii]|[Ss][Hh][Ii][Mm]*.[Ee][Ff][Ii])
                    loader_found=true
                    break
                    ;;
            esac
        done
        [[ "$loader_found" == true ]] || continue
        loader_directories+=("$candidate")
    done

    for candidate in "${candidates[@]}"; do
        for directory in "${loader_directories[@]}"; do
            if [[ "${directory,,}" == "${candidate,,}" ]]; then
                EFI_VENDOR="$directory"
                break 2
            fi
        done
    done

    if [[ -z "$EFI_VENDOR" && "${#loader_directories[@]}" -eq 1 ]]; then
        EFI_VENDOR="${loader_directories[0]}"
    fi

    [[ -n "$EFI_VENDOR" ]] \
        || transaction_fail "Unable to identify one unambiguous existing EFI bootloader directory."

    machine="$(uname -m)"
    case "$machine" in
        x86_64) EFI_TARGET="x86_64-efi" ;;
        aarch64|arm64) EFI_TARGET="arm64-efi" ;;
        i?86) EFI_TARGET="i386-efi" ;;
        *) transaction_fail "Unsupported EFI architecture: $machine" ;;
    esac

    [[ -d "$MOUNTPOINT/usr/lib/grub/$EFI_TARGET" ]] \
        || transaction_fail "GRUB target is not installed in the snapshot: $EFI_TARGET"

    log "Bootloader ID   : $EFI_VENDOR"
    log "EFI target      : $EFI_TARGET"

    transaction_ok "EFI GRUB discovered"
    return 0
}

###############################################################################
# GRUB Installation
###############################################################################

install_grub() {

    log "Installing GRUB without changing UEFI NVRAM..."

    chroot "$MOUNTPOINT" /usr/bin/env -i \
        HOME=/root \
        PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        LANG="${LANG:-C}" \
        grub-install \
            --target="$EFI_TARGET" \
            --efi-directory=/boot/efi \
            --bootloader-id="$EFI_VENDOR" \
            --no-nvram

    transaction_ok "GRUB installed"
    return 0
}

###############################################################################
# Cleanup
###############################################################################

cleanup() {

    [[ -n "$MOUNTPOINT" ]] || return 0

    local cleanup_failed=false

    if mountpoint -q "$MOUNTPOINT/boot/efi" 2>/dev/null; then
        umount "$MOUNTPOINT/boot/efi" || cleanup_failed=true
    fi
    if mountpoint -q "$MOUNTPOINT/boot" 2>/dev/null; then
        umount "$MOUNTPOINT/boot" || cleanup_failed=true
    fi

    for d in run sys proc dev; do
        if mountpoint -q "$MOUNTPOINT/$d" 2>/dev/null; then
            umount -R "$MOUNTPOINT/$d" || cleanup_failed=true
        fi
    done

    if mountpoint -q "$MOUNTPOINT" 2>/dev/null; then
        umount "$MOUNTPOINT" || cleanup_failed=true
    fi

    if [[ "$cleanup_failed" == false && -n "${WORKDIR:-}" && -d "$WORKDIR" ]]; then
        rmdir "$MOUNTPOINT" "$WORKDIR" 2>/dev/null || true
    elif [[ "$cleanup_failed" == true ]]; then
        printf '[WARN] Some temporary mounts could not be removed: %s\n' "$WORKDIR" >&2
    fi

    dbg "Cleanup complete."
    return 0
}

###############################################################################
# Main
###############################################################################

main() {

cat <<EOF
=========================================
 BootPrep
 Version ${VERSION}
=========================================
EOF

    trap cleanup EXIT

    validate

    log "Beginning BootPrep transaction..."

    case "$COMMAND" in

        prepare)

            discover_snapshot
            mount_snapshot
            reconcile_snapshot_store_mounts "$MOUNTPOINT"
            bind_runtime_filesystems
            discover_efi
            prepare_grub
            install_grub

            log "BootPrep transaction completed."
            ;;

    esac

    echo
    transaction_ok "Snapshot prepared successfully."

}

main "$@"
