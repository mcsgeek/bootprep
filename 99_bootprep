set -euo pipefail

# Wrap once so nested installer/engine calls share the same bounded run log.
if [[ $EUID -eq 0 && "${BOOTPREP_LOG_ACTIVE:-}" != 1 && "${1:-}" == rollback-post ]]; then
    command -v python3 >/dev/null 2>&1 || { echo "Please install Python 3 for BootPrep logging." >&2; exit 1; }
    BOOTPREP_LOG_HELPER="/usr/lib/bootprep/bootprep-log.py"
    [[ -f "$BOOTPREP_LOG_HELPER" ]] || { echo "Missing BootPrep logging helper: $BOOTPREP_LOG_HELPER" >&2; exit 1; }
    exec python3 "$BOOTPREP_LOG_HELPER" /bin/bash "${BASH_SOURCE[0]}" "$@"
fi


BOOTPREP="/usr/sbin/bootprep"

# Ignore non-rollback operations.
case "${1:-}" in
    rollback-post)
        ;;
    *)
        exit 0
        ;;
esac

# Ensure BootPrep is installed.
[[ -x "$BOOTPREP" ]] || {
    echo "snapper-bootprep: BootPrep not found: $BOOTPREP" >&2
    exit 1
}

SNAPSHOT="${5:-}"

[[ -n "$SNAPSHOT" ]] || {
    echo "snapper-bootprep: No snapshot number supplied." >&2
    exit 1
}

echo "snapper-bootprep: Preparing rollback snapshot ${SNAPSHOT}..."

exec "$BOOTPREP" prepare "$SNAPSHOT"
